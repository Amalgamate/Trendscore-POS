{
  "name": "Retail OS",
  "version": "1.0.0",
  "description": "Fintech Enterprise x Modern Retail. Calm, precise, trustworthy. No gradients, no glassmorphism.",
  "color": {
    "primitive": {
      "navy900": "#0A1628",
      "navy800": "#0F1F3D",
      "navy700": "#1B2F52",
      "slate900": "#111827",
      "slate700": "#374151",
      "slate500": "#6B7280",
      "slate400": "#9CA3AF",
      "slate300": "#D1D5DB",
      "slate200": "#E5E7EB",
      "slate100": "#F3F4F6",
      "slate050": "#F9FAFB",
      "white": "#FFFFFF",
      "teal700": "#0F766E",
      "teal600": "#0D9488",
      "teal500": "#14B8A6",
      "teal050": "#F0FDFA",
      "green600": "#16A34A",
      "green050": "#F0FDF4",
      "red600": "#DC2626",
      "red050": "#FEF2F2",
      "amber600": "#D97706",
      "amber050": "#FFFBEB",
      "blue600": "#2563EB",
      "blue050": "#EFF6FF"
    },
    "semantic": {
      "bgCanvas": "{color.primitive.slate050}",
      "bgSurface": "{color.primitive.white}",
      "bgSubtle": "{color.primitive.slate100}",
      "bgInverse": "{color.primitive.navy900}",
      "borderSubtle": "{color.primitive.slate200}",
      "borderStrong": "{color.primitive.slate300}",
      "textPrimary": "{color.primitive.slate900}",
      "textSecondary": "{color.primitive.slate700}",
      "textTertiary": "{color.primitive.slate500}",
      "textInverse": "{color.primitive.white}",
      "accentPrimary": "{color.primitive.teal600}",
      "accentInverse": "{color.primitive.navy800}",
      "statusSuccess": "{color.primitive.green600}",
      "statusWarning": "{color.primitive.amber600}",
      "statusDanger": "{color.primitive.red600}",
      "statusInfo": "{color.primitive.blue600}"
    }
  },
  "typography": {
    "fontFamily": "Inter",
    "monoFamily": "JetBrains Mono",
    "size": {
      "xs": "12px",
      "sm": "13px",
      "base": "14px",
      "md": "16px",
      "lg": "18px",
      "xl": "22px",
      "2xl": "28px",
      "3xl": "34px"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "numericFeature": "tnum"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "2xl": "32px",
    "3xl": "48px"
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(16, 24, 40, 0.05)",
    "md": "0 4px 12px rgba(16, 24, 40, 0.08)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  }
}
